  "bin": {
    "answerrail-mcp": "bin/mcp-server.js"
  },
  "type": "module",
  "files": [
    "bin",
    "Dockerfile",
    "LICENSE",
    "README.md",
    "glama.json",
    "mcp.json",
    "smithery.yaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quitegoodproject/answerrail-mcp.git"
  },
  "homepage": "https://answerrail.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llms-txt",
    "ard-schema",
    "lighthouse",
    "aeo",
    "geo",
    "ai-search",
    "answerrail"
  ],
  "author": "The Quite Good Project <engineering@quitegoodproject.com>",
  "license": "MIT",
  "scripts": {
    "build": "node --check bin/mcp-server.js",
